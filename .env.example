# GEMMA / OLLAMA CONFIGURATION
# Connect to your locally installed Gemma model through Ollama (e.g., run `ollama run gemma3:4b` or `ollama run gemma:4b`)
GEMMA_API_URL="http://127.0.0.1:11434"
GEMMA_MODEL="gemma3:4b"

# OPTIONAL: If using a hosted Gemma inference provider after deployment (e.g., Groq, Together, OpenRouter, vLLM, Ollama cloud):
# GEMMA_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
