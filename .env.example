# LM STUDIO CONFIGURATION
# TravelGo.AI talks to a model served by LM Studio's OpenAI-compatible API
# (Developer tab -> Start Server). The backend calls <LM_STUDIO_BASE_URL>/chat/completions.
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
# Must match the model identifier shown in LM Studio (GET <LM_STUDIO_BASE_URL>/models).
LM_STUDIO_MODEL="gemma-3-4b-it-qat"

# OPTIONAL: per-request timeout in milliseconds (default 180000). Increase on slower machines.
# LM_STUDIO_TIMEOUT_MS="180000"

# OPTIONAL: only needed if you enabled API authentication in LM Studio's server settings.
# LM_STUDIO_API_KEY=""

# OPTIONAL: port for the TravelGo.AI server (default 3000).
# PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
